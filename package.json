{
  "name": "ucp-audit",
  "version": "0.1.0",
  "description": "Checks whether a shop is actually reachable by AI shopping agents: reads the Universal Commerce Protocol profile at /.well-known/ucp and reports what would make an agent skip it.",
  "type": "module",
  "bin": {
    "ucp-audit": "dist/src/main.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/main.js"
  },
  "keywords": [
    "ucp",
    "universal-commerce-protocol",
    "agentic-commerce",
    "shopify",
    "ecommerce",
    "ai-agents",
    "audit",
    "cli"
  ],
  "license": "MIT",
  "author": "Dmytro Galko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkautomation23/ucp-audit.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
